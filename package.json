{
  "name": "temari",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config vite.pages.config.ts --host 127.0.0.1",
    "build": "node scripts/build-pages.mjs",
    "preview": "vite preview --config vite.pages.config.ts --host 127.0.0.1 --port 4174 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/components/temari/*.test.ts",
    "test:fast": "node scripts/run-test-group.mjs fast",
    "test:slow": "node scripts/run-test-group.mjs slow",
    "check:docs": "node scripts/sync-design.mjs --check",
    "check:upper-section": "tsx scripts/diagnose-studio-catch-section.mts --assert-section",
    "check:craft-coverage": "tsx scripts/check-craft-coverage.mts"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "clsx": "2.1.1",
    "lucide-react": "0.510.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.5.0",
    "three": "0.185.1",
    "zustand": "5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "22.16.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "5.2.0",
    "playwright": "1.62.0",
    "tailwindcss": "4.3.0",
    "tsx": "4.20.0",
    "typescript": "5.7.3",
    "vite": "8.2.0"
  }
}
