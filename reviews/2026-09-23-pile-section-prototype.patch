+    assert.ok(lift < 0.95 * rigid, `soft ${lift} vs rigid ${rigid}`);
+    // The side towards the neighbour (−(t × up) here) is the one held up.
+    assert.ok(roll < (-10 * Math.PI) / 180, `roll ${roll}`);
+  });
+
+  it("keeps a shingle of ten threads low where rigid beads climb it as a stair", () => {
+    const lines = Array.from({ length: 10 }, (_, k) => shingle(0.6 * k));
+    const rigid = pileHeights(lines, opts).map(mid);
+    const soft10 = pileHeights(lines, soft).map(mid);
+    assert.ok(rigid[9]! > 6 * H, `rigid stair ${rigid[9]}`);
+    assert.ok(Math.max(...soft10) < 1.2 * H, `soft ${soft10.map((v) => (v / H).toFixed(2)).join(" ")}`);
+  });
+
+  it("compacts a thread borne by thread, not one on the mari", () => {
+    const pile = pileLay([{ points: run("x", 0) }, { points: run("z", 0) }], { ...opts, compaction: 0.2 });
+    // The later loses 20 % of its height where it lies on the earlier; the
+    // earlier is not redrawn, so the pair is 10 % lower.
+    assert.ok(Math.abs(mid(pile.lifts[1]!) - 0.9 * H) < 1e-6, `${mid(pile.lifts[1]!)}`);
+    assert.ok(Math.abs(mid(pile.flat![1]!) - 0.8) < 1e-9);
+    assert.equal(pile.flat![1]![0], 1);
+    assert.equal(pile.lifts[1]![0], 0);
+  });
+
+  it("never lets a bead cut into an earlier bead", () => {
+    const lines = [shingle(0), shingle(0.6), shingle(1.2), { points: run("z", 0) }, { points: run("z", W * 0.7) }];
+    const pile = pileLay(lines, { ...soft, compaction: 0.17 });
+    const reach = W / 2;
+    const { pos, lift, height } = pile.section!;
+    let worst = -Infinity;
+    for (let a = 0; a < lines.length; a++) for (let b = a + 1; b < lines.length; b++) {
+      for (let i = 0; i < pos[a]!.length / 3; i++) for (let j = 0; j < pos[b]!.length / 3; j++) {
+        const d = Math.hypot(pos[a]![i * 3]! - pos[b]![j * 3]!, pos[a]![i * 3 + 1]! - pos[b]![j * 3 + 1]!,
+          pos[a]![i * 3 + 2]! - pos[b]![j * 3 + 2]!);
+        if (d >= reach) continue;
+        const need = ((height[a]![i]! + height[b]![j]!) / 2) * Math.sqrt(1 - (d / reach) ** 2);
+        worst = Math.max(worst, need - (lift[b]![j]! - lift[a]![i]!));
+      }
+    }
+    assert.equal(pile.beads, 5);
+    // Beads are kept on the unit sphere, the search measures them off it: a
+    // difference of the order (width / radius)², a thousandth of the height.
+    assert.ok(worst < 1e-3 * H, `worst cut ${worst / H} of the height`);
+  });
+
+  it("lays only what changed after an earlier soft pile, with the same heights, rolls and flattening", () => {
+    const o = { ...soft, compaction: 0.17 };
+    const diag = run("x", 0).map(([x, y]) => norm([x, y, x]));
+    const before = [shingle(0), shingle(0.6), { points: diag }];
+    const pile = pileLay(before, o);
+    for (const next of [[...before, { points: run("z", 0) }], [before[0]!, before[1]!, shingle(1.2)]]) {
+      const again = pileLay(next, o, pile), fresh = pileLay(next, o);
+      assert.ok(again.kept! >= 2, `kept ${again.kept}`);
+      assert.deepEqual(again.lifts, fresh.lifts);
+      assert.deepEqual(again.roll, fresh.roll);
+      assert.deepEqual(again.flat, fresh.flat);
+    }
+  });
+});
