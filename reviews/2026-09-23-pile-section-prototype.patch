+/**
+ * Clearance of the soft-section pile under its own rule (#93, pile-heights.ts):
+ * the section is the hull of its two plies, carried by beads a ply across
+ * along its rolled core; two beads of different pieces, both above the mari,
+ * may not sit closer than their (compacted) heights allow at their plan
+ * distance. `count-studio-overlaps.mts --pile` checks the axes against the
+ * rigid level section instead, so there a rolled or compacted thread counts
+ * as an overlap by construction.
+ *
+ *   node --import tsx scripts/check-soft-pile.mts --rounds=4 --set=all
+ *   ... --strands=1 --compaction=0   the rigid bead (then this equals «Оси»)
+ */
+import { compileKiku, stitchesFromOps } from '../src/components/temari/patterns.ts';
+import { PILE_SECTION, pileParts } from '../src/components/temari/stitches.ts';
+import { MARI_C_CM } from '../src/components/temari/measure.ts';
+
+const arg = (name: string, fallback: string) =>
+  process.argv.find(a => a.startsWith(`--${name}=`))?.slice(name.length + 3) ?? fallback;
+const rounds = Number(arg('rounds', '2'));
+const set = arg('set', '0') === 'all' ? 'all' as const : 0;
+if (arg('strands', '') !== '') PILE_SECTION.strands = Number(arg('strands', '2'));
+if (arg('compaction', '') !== '') PILE_SECTION.compaction = Number(arg('compaction', '0'));
+const R_MM = (MARI_C_CM * 10) / (2 * Math.PI);
+const W = 0.71 / R_MM;
+const H = W * 0.5;
+const plies = Math.max(1, Math.round(PILE_SECTION.strands));
+const reach = W / plies;
+
+const arcs = stitchesFromOps(compileKiku('simple', 'out', 'even', 0, 0, rounds, set));
+const pieces = pileParts(arcs, 'pearl5');
+type Bead = { piece: number; x: number; y: number; z: number; r: number; h: number };
+const beads: Bead[] = [];
+pieces.forEach((piece, i) => {
+  const K = piece.plies.strands;
+  piece.pts.forEach((p, j) => {
+    const r = p.length();
+    if (r <= 1) return;
+    for (let k = 0; k < K; k++) {
+      const s = j * K + k;
+      beads.push({
+        piece: i,
+        x: piece.plies.pos[s * 3]!, y: piece.plies.pos[s * 3 + 1]!, z: piece.plies.pos[s * 3 + 2]!,
+        // Absolute radius of the bead: the drawn axis plus its roll offset.
+        r: r + piece.plies.lift[s]! - piece.lift[j]!,
+        h: piece.plies.height[s]!,
+      });
+    }
+  });
+});
+const cell = (b: Bead) => [b.x, b.y, b.z].map(v => Math.floor(v / reach));
+const grid = new Map<string, number[]>();
+beads.forEach((b, i) => {
+  const k = cell(b).join(',');
+  (grid.get(k) ?? grid.set(k, []).get(k)!).push(i);
+});
+let pairs = 0, worst = 0;
+beads.forEach((b, i) => {
+  const [x, y, z] = cell(b);
+  for (let a = -1; a <= 1; a++) for (let c = -1; c <= 1; c++) for (let d = -1; d <= 1; d++) {
+    for (const j of grid.get(`${x + a},${y + c},${z + d}`) ?? []) {
+      const q = beads[j]!;
+      if (q.piece <= b.piece) continue;
+      const lat = Math.hypot(b.x - q.x, b.y - q.y, b.z - q.z);
+      if (lat >= reach) continue;
+      const need = (b.h + q.h) / 2 * Math.sqrt(1 - (lat / reach) ** 2);
+      const short = need - Math.abs(b.r - q.r);
+      if (short > 0.05 * H) { pairs++; worst = Math.max(worst, short); }
+    }
+  }
+});
+console.log(`Мягкое сечение: нитей ${plies}, сжатие ${PILE_SECTION.compaction.toFixed(3)}; кругов ${rounds}, группы ${set}: ${pieces.length} кусков, ${beads.length} бусин.`);
+console.log(`Оси (мягкое сечение): пар бусин ближе сечения ${pairs}${pairs ? `, худшая на ${(worst * R_MM).toFixed(3)} мм` : ''}.`);
