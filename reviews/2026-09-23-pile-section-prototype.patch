@@ -0,0 +1,40 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { compileKiku, stitchesFromOps } from "./patterns.ts";
+import { PILE_SECTION, compactionFor, pileParts } from "./stitches.ts";
+import { MARI_C_CM } from "./measure.ts";
+
+const R_MM = (MARI_C_CM * 10) / (2 * Math.PI);
+
+/** Highest axis (mm above the mari) per round at the upper tips (< 20 mm from the pole). */
+function upperByRound(): number[] {
+  const parts = pileParts(stitchesFromOps(compileKiku("simple", "out", "even", 0, 0, 10, "all")), "pearl5");
+  const rows: number[] = [];
+  for (const p of parts) {
+    const m = (p.at.operation?.operationId ?? "").match(/\/s\d\/r(\d+)\//);
+    if (!m) continue;
+    const r = Number(m[1]);
+    for (const q of p.pts) {
+      const polar = Math.acos(Math.min(1, q.y / q.length())) * R_MM;
+      if (polar < 20) rows[r] = Math.max(rows[r] ?? 0, (q.length() - 1) * R_MM);
+    }
+  }
+  return rows;
+}
+
+describe("pile render: soft section of pearl cotton (#93)", () => {
+  it("takes its numbers from the material: two plies, packing 200 tex / 1.52 g/cm³ up to 0.8", () => {
+    assert.equal(PILE_SECTION.strands, 2);
+    // 0.1316 mm² of fibre in a laid 0.71 × 0.355 mm section: packing 0.665.
+    assert.ok(Math.abs(PILE_SECTION.compaction - (1 - 0.665 / 0.8)) < 0.005, `${PILE_SECTION.compaction}`);
+    assert.ok(compactionFor(236, 0.8) < 0.03, "the 5/2 count leaves almost no room to pack");
+  });
+
+  it("keeps ten rounds' upper tips a low braid, not a stair (full S8 kiku, both sets)", () => {
+    const rows = upperByRound();
+    assert.equal(rows.length, 10);
+    // Rigid level beads: 0.53 → 5.26 mm, +0.53 mm a round.
+    assert.ok(Math.max(...rows) < 2.5, `upper tips ${rows.map((v) => v.toFixed(2)).join(" ")}`);
+    assert.ok(rows[9]! <= rows[4]! + 0.71, `the last five rounds climb ${(rows[9]! - rows[4]!).toFixed(2)} mm`);
+  });
+});
