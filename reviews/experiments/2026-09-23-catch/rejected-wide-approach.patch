+function segmentRadius(a: Vector3, b: Vector3) {
+  const d = b.clone().sub(a);
+  const t = Math.max(0, Math.min(1, -a.dot(d) / d.lengthSq()));
+  return a.clone().addScaledVector(d, t).length();
+}
+
+describe("fixed upper approach interpolation (not a contact certificate)", () => {
+  it("retains both endpoints and approaches the surface from outside with the specified tangents", () => {
+    const from = new Vector3(4, 42, 0), port = new Vector3(0, 40, 0), tangent = new Vector3(-1, .1, .2);
+    const before = [from.toArray(), port.toArray(), tangent.toArray()];
+    const { points } = fixedPortApproach(from, tangent, port, .01);
+    assert.deepEqual(points[0], from);
+    assert.deepEqual(points.at(-1), port);
+    assert.deepEqual([from.toArray(), port.toArray(), tangent.toArray()], before);
+    for (let i = 1; i < points.length; i++) assert.ok(segmentRadius(points[i - 1]!, points[i]!) >= 40 - 1e-12);
+    const start = points[1]!.clone().sub(points[0]!).normalize();
+    const end = points.at(-1)!.clone().sub(points.at(-2)!).normalize();
+    assert.ok(start.dot(tangent.clone().normalize()) > .9999);
+    assert.ok(end.dot(port.clone().normalize().negate()) > .9999);
+  });
+
+  it("does not push the path into the sphere to honour a steep downward flank tangent", () => {
+    const port = new Vector3(0, 1, 0);
+    const { points } = fixedPortApproach(new Vector3(.06, 1.002, 0), new Vector3(-.01, -1, 0), port, .0001);
+    for (let i = 1; i < points.length; i++) assert.ok(segmentRadius(points[i - 1]!, points[i]!) >= 1 - 1e-12);
+    assert.ok(points.slice(0, -1).every(p => p.length() > 1));
+  });
+
+  it("rejects absent exterior clearance and invalid inputs", () => {
+    for (const from of [new Vector3(0, 1, 0), new Vector3(0, .9, 0), new Vector3(NaN, 2, 0)]) {
+      assert.throws(() => fixedPortApproach(from, new Vector3(1, 0, 0), new Vector3(0, 1, 0), .01), RangeError);
+    }
+    assert.throws(() => fixedPortApproach(new Vector3(0, 2, 0), new Vector3(), new Vector3(0, 1, 0), .01), RangeError);
+    assert.throws(() => fixedPortApproach(new Vector3(0, 2, 0), new Vector3(1, 0, 0), new Vector3(0, 1, 0), 0), RangeError);
+  });
+
+  for (const set of [0, 1, "all"] as const) it(`keeps actual stacked mouths at recipe R after pile and mesh smoothing, set ${set}`, () => {
+    const stitches = stitchesFromOps(compileKiku("simple", "out", "even", 0, 0, 3, set));
+    const parts = pileParts(stitches, "pearl5");
+    const byId = new Map(stitches.filter(s => s.kind === "arc").map(s => [s.operation!.operationId, s]));
+    const meshes = createMotifGeometryParts(stitches, 0, "pearl5", { pile: true });
+    let mouths = 0;
+    for (const part of parts) {
+      const mesh = meshes.find(g => g.userData.operationId === part.at.operation!.operationId)!;
+      const smoothed = mesh.userData.sampledCenterline as Vector3[];
+      for (const fixed of part.fixedPorts ?? []) {
+        mouths++;
+        const owner = byId.get(fixed.operationId)!;
+        assert.equal(owner.tip, "inner");
+        assert.ok(owner.operation!.overOperations.length > 0);
+        assert.ok([owner.bite!.enter, owner.bite!.exit].some(v => new Vector3(...v).normalize().distanceTo(fixed.point) < 1e-12));
+        assert.ok(Math.abs(fixed.point.length() - 1) < 1e-12);
+        assert.equal(part.pts[fixed.index]!.distanceTo(fixed.point), 0);
+        assert.equal(Math.min(...smoothed.map(p => p.distanceTo(fixed.point))), 0, "smoothing must retain the explicit R knot");
+        checkPortNeighbourhood(part.pts, fixed);
+        const lo = Math.min(fixed.approachIndex, fixed.index), hi = Math.max(fixed.approachIndex, fixed.index);
+        for (let j = lo + 1; j <= hi; j++) assert.ok(segmentRadius(part.pts[j - 1]!, part.pts[j]!) >= 1 - 1e-12,
+          "the entire finite exterior polyline must stay outside R");
+        checkPortNeighbourhood(smoothed, { ...fixed, index: smoothed.findIndex(p => p.distanceTo(fixed.point) === 0) });
+        // A real mesh ring is centred at the fixed port (Float32 mesh tolerance).
+        const ring = smoothed.findIndex(p => p.distanceTo(fixed.point) === 0);
+        const position = mesh.getAttribute("position"), stride = position.count / smoothed.length;
+        const center = new Vector3();
+        for (let j = 0; j < stride - 1; j++) center.add(new Vector3().fromBufferAttribute(position, ring * stride + j));
+        center.divideScalar(stride - 1);
+        assert.ok(center.distanceTo(fixed.point) < 1e-7);
+      }
+    }
+    assert.equal(mouths, set === "all" ? 32 : 16);
+  });
+
+  it("assigns fixed mouths only to executed catches and leaves first-row paths without new constraints", () => {
+    for (const count of [8, 9, 10, 11, 12, 16, 17, 18, 19, 24]) {
+      const stitches = stitchesFromOps(compileKiku("simple", "out", "even", 0, 0, 3, 0, count));
+      const executed = new Set(stitches.filter(s => s.kind === "arc").map(s => s.operation!.operationId));
+      const parts = pileParts(stitches, "pearl5");
+      for (const part of parts) for (const port of part.fixedPorts ?? []) assert.ok(executed.has(port.operationId));
+      if (count === 8) assert.equal(parts.flatMap(p => p.fixedPorts ?? []).length, 0);
+    }
+  });
+});
+
+function checkPortNeighbourhood(points: Vector3[], fixed: FixedSurfacePort) {
+  const outward = fixed.side === "start" ? 1 : -1;
+  const exterior = points[fixed.index + outward]!, interior = points[fixed.index - outward]!;
+  assert.ok(exterior.length() > 1, "last exterior segment approaches R from outside");
+  assert.ok(segmentRadius(points[fixed.index]!, exterior) >= 1 - 1e-12, "finite approach segment must not enter early");
+  assert.ok(interior.length() < 1, "hidden continuation begins at this same mouth");
+  assert.ok(interior.clone().normalize().distanceTo(fixed.point) < 1e-4, "legacy radial hidden endpoint tangent");
+}
