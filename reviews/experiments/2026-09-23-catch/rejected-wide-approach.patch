index 0000000..31604ab
--- /dev/null
+++ b/src/components/temari/fixed-port-approach.ts
@@ -0,0 +1,31 @@
+import { Vector3 } from "three";
+
+/** Kinematic interpolation to a fixed surface mouth, not a contact/needle solver. */
+export function fixedPortApproach(from: Vector3, tangent: Vector3, port: Vector3, step: number) {
+  const R = port.length(), r0 = from.length(), height = r0 - R;
+  if (![R, r0, step, ...tangent.toArray(), ...port.toArray()].every(Number.isFinite)
+    || R <= 0 || step <= 0 || height <= 0 || tangent.lengthSq() === 0) {
+    throw new RangeError("A finite exterior endpoint, tangent, surface port and positive step are required.");
+  }
+  const n0 = from.clone().normalize(), n1 = port.clone().normalize(), direction = tangent.clone().normalize();
+  const radialSlope = direction.dot(n0);
+  // Limit the first handle by the positive radial control hull. Its direction
+  // stays the measured flank tangent; no radius/section is reduced to fit.
+  const handle = Math.min(from.distanceTo(port), radialSlope < 0 ? 3 * height / -radialSlope : Infinity);
+  const q1 = n0.clone().addScaledVector(direction.clone().addScaledVector(n0, -radialSlope), handle / (3 * r0));
+  const r1 = Math.max(R, r0 + radialSlope * handle / 3), r2 = R + height / 3;
+  const count = Math.max(32, Math.ceil((from.distanceTo(port) + height) / step) * 3);
+  const points: Vector3[] = [];
+  for (let i = 0; i <= count; i++) {
+    const t = i / count, u = 1 - t;
+    const radius = r0 * u ** 3 + 3 * r1 * u * u * t + 3 * r2 * u * t * t + R * t ** 3;
+    const q = n0.clone().multiplyScalar(u ** 3).addScaledVector(q1, 3 * u * u * t)
+      .addScaledVector(n1, 3 * u * t * t + t ** 3);
+    if (q.lengthSq() < 1e-20) throw new RangeError("The local direction interpolation crosses its origin.");
+    points.push(q.normalize().multiplyScalar(radius));
+  }
+  points[0] = from.clone(); points[count] = port.clone();
+  return { points, radiusControls: [r0, r1, r2, R] as const,
+    startTangent: direction, endTangent: n1.negate(),
+    model: "positive-radial-cubic-to-fixed-mouth" as const };
+}
